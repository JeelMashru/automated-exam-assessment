# Environment Configuration Template for Automated Descriptive Exam Assessment Engine
# Copy this file to .env and configure your keys. Never commit your actual .env file.

# LLM Provider Configuration
LLM_PROVIDER=gemini # options: gemini, openai, mock
LLM_MODEL=gemini-2.5-flash

# API Credentials (Set at least one real key to enable live evaluation)
# Get Google Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=
# Or GOOGLE_API_KEY=

# Optional OpenAI API Key (if using openai provider)
OPENAI_API_KEY=

# LLM Generation Parameters
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Optional Semantic Similarity Embedding Settings
ENABLE_EMBEDDINGS=false

# Database Configuration (defaults to local SQLite inside data/)
DATABASE_URL=sqlite:///data/assessment.db
